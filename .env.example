# The same Postgres database the platform project uses.
DATABASE_URL=

# Where the platform project is published, with no slash at the end.
PLATFORM_URL=

# The same long random text set in the platform project. It lets this
# dashboard ask the platform to do what only a product knows how to do.
INTERNAL_API_SECRET=

# Lets the dashboard make a database of the customer's own at Neon
# (console.neon.tech > Account settings > API keys). Without it the owner
# pastes the link of a database made by hand.
NEON_API_KEY=
# Only with a personal key on a Neon account that has several organizations.
NEON_ORG_ID=
# Where new databases are made. Defaults to aws-us-east-1.
NEON_REGION=
